migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android/Gradle build output
/android/build/

# JVM crash logs and heap dumps (can be hundreds of MB, never commit these)
*.hprof
hs_err_pid*.log
replay_pid*.log

# Backend reference source (read-only ground truth, not part of this Flutter app)
# Note the trailing space in the directory name itself (as provided) --
# both variants ignored in case it's ever re-provided without the space.
/Hoqooq-main/
/Hoqooq-main /

# Local device-automation scratch: adb UI dumps, screenshots, and captured
# API responses (the latter can contain live access tokens).
/.tmp_device/
